<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
                      xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
                      xsi:type="MailApp">

             <!-- Unique ID for this add-in. Keep it the same if you ever update the add-in. -->
             <Id>3f2a9c4e-7b1d-4e8a-9c6f-2d5b8a1e4f70</Id>
             <Version>1.0.0.0</Version>
             <ProviderName>Aligned Print Co.</ProviderName>
             <DefaultLocale>en-US</DefaultLocale>
             <DisplayName DefaultValue="Email Notes"/>
             <Description DefaultValue="Attach private notes (customer info, paper type, job details) to any email."/>
             <IconUrl DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-64.png"/>
             <HighResolutionIconUrl DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-128.png"/>
             <SupportUrl DefaultValue="https://alignedprint.com"/>

             <Hosts>
                            <Host Name="Mailbox"/>
             </Hosts>

             <Requirements>
                            <Sets>
                                             <Set Name="Mailbox" MinVersion="1.5"/>
                            </Sets>
             </Requirements>

             <FormSettings>
                            <Form xsi:type="ItemRead">
                                             <DesktopSettings>
                                                                <SourceLocation DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/taskpane.html"/>
                                                                <RequestedHeight>250</RequestedHeight>
                                             </DesktopSettings>
                            </Form>
             </FormSettings>

             <Permissions>ReadWriteItem</Permissions>

             <Rule xsi:type="RuleCollection" Mode="Or">
                            <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
             </Rule>

             <DisableEntityHighlighting>false</DisableEntityHighlighting>

             <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
                            <Requirements>
                                             <bt:Sets DefaultMinVersion="1.5">
                                                                <bt:Set Name="Mailbox"/>
                                             </bt:Sets>
                            </Requirements>

                            <Hosts>
                                             <Host xsi:type="MailHost">
                                                                <DesktopFormFactor>
                                                                                     <ExtensionPoint xsi:type="MessageReadCommandSurface">
                                                                                                            <OfficeTab id="TabDefault">
                                                                                                                                     <Group id="grpNotes">
                                                                                                                                                                <Label resid="grpNotes.Label"/>
                                                                                                                                                                <Control xsi:type="Button" id="btnOpenNotes">
                                                                                                                                                                                             <Label resid="btnOpenNotes.Label"/>
                                                                                                                                                                                             <Supertip>
                                                                                                                                                                                                                            <Title resid="btnOpenNotes.Label"/>
                                                                                                                                                                                                                            <Description resid="btnOpenNotes.Tooltip"/>
                                                                                                                                                                                                                          </Supertip>
                                                                                                                                                                                             <Icon>
                                                                                                                                                                                                                            <bt:Image size="16" resid="Icon.16"/>
                                                                                                                                                                                                                            <bt:Image size="32" resid="Icon.32"/>
                                                                                                                                                                                                                            <bt:Image size="80" resid="Icon.80"/>
                                                                                                                                                                                                                          </Icon>
                                                                                                                                                                                             <Action xsi:type="ShowTaskpane">
                                                                                                                                                                                                                            <SourceLocation resid="Taskpane.Url"/>
                                                                                                                                                                                                                          </Action>
                                                                                                                                                                           </Control>
                                                                                                                                                </Group>
                                                                                                                       </OfficeTab>
                                                                                                </ExtensionPoint>
                                                                </DesktopFormFactor>
                                             </Host>
                            </Hosts>

                            <Resources>
                                             <bt:Images>
                                                                <bt:Image id="Icon.16" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-16.png"/>
                                                                <bt:Image id="Icon.32" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-32.png"/>
                                                                <bt:Image id="Icon.80" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-80.png"/>
                                             </bt:Images>
                                             <bt:Urls>
                                                                <bt:Url id="Taskpane.Url" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/taskpane.html"/>
                                             </bt:Urls>
                                             <bt:ShortStrings>
                                                                <bt:String id="grpNotes.Label" DefaultValue="Notes"/>
                                                                <bt:String id="btnOpenNotes.Label" DefaultValue="Email Notes"/>
                                             </bt:ShortStrings>
                                             <bt:LongStrings>
                                                                <bt:String id="btnOpenNotes.Tooltip" DefaultValue="Open a notes panel for this email. Pin it to keep it open as you click through your inbox."/>
                                             </bt:LongStrings>
                            </Resources>
                            <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
                                             <Requirements>
                                                                <bt:Sets DefaultMinVersion="1.5">
                                                                                     <bt:Set Name="Mailbox"/>
                                                                </bt:Sets>
                                             </Requirements>

                                             <Hosts>
                                                                <Host xsi:type="MailHost">
                                                                                     <DesktopFormFactor>
                                                                                                            <ExtensionPoint xsi:type="MessageReadCommandSurface">
                                                                                                                                     <OfficeTab id="TabDefault">
                                                                                                                                                                <Group id="grpNotes">
                                                                                                                                                                                             <Label resid="grpNotes.Label"/>
                                                                                                                                                                                             <Control xsi:type="Button" id="btnOpenNotes">
                                                                                                                                                                                                                            <Label resid="btnOpenNotes.Label"/>
                                                                                                                                                                                                                            <Supertip>
                                                                                                                                                                                                                                                             <Title resid="btnOpenNotes.Label"/>
                                                                                                                                                                                                                                                             <Description resid="btnOpenNotes.Tooltip"/>
                                                                                                                                                                                                                                                           </Supertip>
                                                                                                                                                                                                                            <Icon>
                                                                                                                                                                                                                                                             <bt:Image size="16" resid="Icon.16"/>
                                                                                                                                                                                                                                                             <bt:Image size="32" resid="Icon.32"/>
                                                                                                                                                                                                                                                             <bt:Image size="80" resid="Icon.80"/>
                                                                                                                                                                                                                                                           </Icon>
                                                                                                                                                                                                                            <Action xsi:type="ShowTaskpane">
                                                                                                                                                                                                                                                             <SourceLocation resid="Taskpane.Url"/>
                                                                                                                                                                                                                                                             <SupportsPinning>true</SupportsPinning>
                                                                                                                                                                                                                                                           </Action>
                                                                                                                                                                                                                          </Control>
                                                                                                                                                                           </Group>
                                                                                                                                                </OfficeTab>
                                                                                                                       </ExtensionPoint>
                                                                                                </DesktopFormFactor>
                                                                </Host>
                                             </Hosts>

                                             <Resources>
                                                                <bt:Images>
                                                                                     <bt:Image id="Icon.16" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-16.png"/>
                                                                                     <bt:Image id="Icon.32" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-32.png"/>
                                                                                     <bt:Image id="Icon.80" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/icon-80.png"/>
                                                                </bt:Images>
                                                                <bt:Urls>
                                                                                     <bt:Url id="Taskpane.Url" DefaultValue="https://alignedprintco-source.github.io/outlook-email-notes/taskpane.html"/>
                                                                </bt:Urls>
                                                                <bt:ShortStrings>
                                                                                     <bt:String id="grpNotes.Label" DefaultValue="Notes"/>
                                                                                     <bt:String id="btnOpenNotes.Label" DefaultValue="Email Notes"/>
                                                                </bt:ShortStrings>
                                                                <bt:LongStrings>
                                                                                     <bt:String id="btnOpenNotes.Tooltip" DefaultValue="Open a notes panel for this email. Pin it to keep it open as you click through your inbox."/>
                                                                </bt:LongStrings>
                                             </Resources>
                            </VersionOverrides>
             </VersionOverrides>
</OfficeApp>
